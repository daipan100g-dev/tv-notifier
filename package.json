{
  "name": "tv-notifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-sw.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:worker",
    "test:worker": "npm run worker:check && node --test tests/runtime.test.mjs",
    "worker:dev": "wrangler dev --config wrangler.local.jsonc --test-scheduled",
    "worker:check": "wrangler deploy --dry-run --outdir worker-dist",
    "keys": "node scripts/generate-keys.mjs"
  },
  "dependencies": {
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.1",
    "miniflare": "5.20261019.0-beta",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.4.4",
    "wrangler": "4.151.2"
  }
}
